# Proma Web Server 环境变量（server/.env，权限 600）
# 所有变量均可选，未设置时使用内置默认值（见 server.ts 对应读取处）

# 必填：访问令牌（install.sh 自动生成；手动部署用 openssl rand -hex 32 生成）
# 安全：.env 必须 chmod 600；不要通过 URL 参数长期暴露（浏览器会自动转存并清除）
PROMA_WEB_TOKEN=
# 必填：Proma 源码目录（patch 后）
PROMA_SRC=/opt/Proma
# 可选：HTTP/WS 端口（默认 6810）
PROMA_WEB_PORT=6810
# 可选：监听地址（局域网访问设 0.0.0.0，默认 127.0.0.1；⚠️ 0.0.0.0 务必配 HTTPS 反代）
# 注意：install.sh 部署时会把 PROMA_WEB_HOST 写入 .env（默认 0.0.0.0）；手工部署以本文件为准
PROMA_WEB_HOST=127.0.0.1
# 可选：错误响应含堆栈（默认脱敏，只返回 trace id）
PROMA_WEB_VERBOSE_ERRORS=0
# 可选：Origin 白名单（逗号分隔，如 http://<server-ip>:6810）；默认仅允许同源
PROMA_WEB_ALLOWED_ORIGINS=
# 可选：单条 WS 消息上限字节（默认 4194304 = 4MB；Web 附件约 3MB base64 即触顶）
PROMA_WEB_MAX_MSG_BYTES=4194304
# 可选：invoke 超时毫秒（默认 120000）
PROMA_WEB_INVOKE_TIMEOUT_MS=120000
# 可选：每连接 invoke 速率（滑动窗口 60s，默认 600）
PROMA_WEB_RATE_LIMIT=600
# 可选：出站 result 大小上限字节（默认 16777216 = 16MB）
PROMA_WEB_MAX_RESULT_BYTES=16777216
# 可选：invoke args 最大递归深度（默认 20）
PROMA_WEB_MAX_ARGS_DEPTH=20
# 可选：同 IP 新连接频率（滑动窗口 10s，默认 10）
PROMA_WEB_CONN_RATE_LIMIT=10
# 可选：可信反代模式（nginx 反代后按 X-Forwarded-For 取真实客户端 IP 做限频；仅限可信反代，否则可伪造）
# 注意：XFF 可轮换绕过限频（限频是尽力而为），生产建议 nginx 层再配 limit_req/limit_conn
PROMA_WEB_TRUST_PROXY=0
# 可选：数据目录（默认 ~/.proma-web；含渠道加密密钥 .safe-key，勿与桌面版 ~/.proma 混用）
PROMA_WEB_USER_DATA=
# 可选：渠道加密安全密钥（不设置则自动持久化到 <userData>/.safe-key，建议 32+ 字节强随机）
PROMA_WEB_SAFE_KEY=
# 可选：日志级别（默认 info）
PROMA_WEB_LOG_LEVEL=info
# 可选：上报给 renderer 的 Proma 版本号（默认读 PROMA_SRC/package.json）
PROMA_WEB_PROMA_VERSION=
# 可选：测试模式（仅开发/回归验证用，注册 _test: 通道；生产勿开）
PROMA_WEB_TEST_MODE=0
