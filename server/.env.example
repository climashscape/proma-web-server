# 必填：访问令牌（install.sh 自动生成；手动部署用 openssl rand -hex 32 生成）
PROMA_WEB_TOKEN=
# 必填：Proma 源码目录（patch 后）
PROMA_SRC=/opt/Proma
# 可选：HTTP/WS 端口（默认 6810）
PROMA_WEB_PORT=6810
# 可选：监听地址（局域网访问设 0.0.0.0，默认 127.0.0.1）
PROMA_WEB_HOST=127.0.0.1
# 可选：错误响应含堆栈（默认脱敏）
PROMA_WEB_VERBOSE_ERRORS=0
# 可选：Origin 白名单（逗号分隔，如 http://<server-ip>:6810）
PROMA_WEB_ALLOWED_ORIGINS=
