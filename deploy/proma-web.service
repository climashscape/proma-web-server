# Proma Web Server systemd unit 模板（M5 部署衔接）
#
# 适用：Linux 主机 / NAS（飞牛 fpk 打包见阶段 5，此处为通用 systemd 方案）
# 使用：
#   1. 拷贝 server 目录到部署目录（如 /opt/proma-web/server）
#   2. 替换下面环境变量占位符（或直接走 deploy/install.sh 自动生成）
#   3. sudo cp deploy/proma-web.service /etc/systemd/system/
#   4. sudo systemctl daemon-reload && sudo systemctl enable --now proma-web
#
# 注意：NAS 部署建议改用 fpk（run-as root + runuser 切换 <app-user>）；本 unit 是独立主机/调试环境的衔接模板。

[Unit]
Description=Proma Web Server (WS IPC bridge for Proma Web 化)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# 数据目录归属用户（如 NAS 上为 <app-user>；本机开发可为当前用户）
User=__RUN_USER__
Group=__RUN_GROUP__
# ⚠️ 必须指向仓库的 server 目录（server.ts 依赖 cwd 定位 public/ 与 .env）；
# install.sh 会自动替换；手工部署请改为 <repo>/server
WorkingDirectory=/opt/proma-web/server

# ---- 必填 ----
# token 从 EnvironmentFile 读取（.env 权限 600，避免 unit 文件 644 泄露明文 token）；
# 由 install.sh 生成；手工部署请指向含 PROMA_WEB_TOKEN 的 600 权限文件
EnvironmentFile=__ENV_FILE__
# 监听地址在 .env 中配置（PROMA_WEB_HOST，install.sh 默认写 0.0.0.0 局域网可访问；仅本机改 127.0.0.1）
# ⚠️ 0.0.0.0 暴露给局域网时务必配 HTTPS 反代
Environment=PROMA_WEB_PORT=6810
Environment=PROMA_SRC=__PROMA_SRC__
# 数据目录：NAS 用 /vol1/@appdata/proma；独立主机可用 ~/.proma-web
Environment=PROMA_WEB_USER_DATA=__DATA_DIR__
# 可选：安全密钥（不设置则自动持久化到 <userData>/.safe-key）
# Environment=PROMA_WEB_SAFE_KEY=__SAFE_KEY__

# ---- 日志/限制 ----
Environment=PROMA_WEB_LOG_LEVEL=info
Environment=PROMA_WEB_MAX_MSG_BYTES=4194304
Environment=PROMA_WEB_INVOKE_TIMEOUT_MS=120000
Environment=PROMA_WEB_RATE_LIMIT=600

# ---- 运行 ----
Environment=PATH=/usr/local/bin:/usr/bin:/bin
ExecStart=/usr/local/bin/bun run server.ts
Restart=on-failure
RestartSec=5
TimeoutStopSec=15

# ---- 安全加固（按需裁剪）----
# M8：ProtectHome=true 会隐藏 /root，而 stub 的 app.getPath('home') 等依赖 homedir()；
# 若数据目录在 /vol1 或独立路径且无需 home，可保持 true；否则设 false。
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=__DATA_DIR__
ProtectHome=false

[Install]
WantedBy=multi-user.target
