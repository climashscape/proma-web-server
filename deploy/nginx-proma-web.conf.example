# Proma Web Server nginx 反代示例（★必须用 $http_host，不能用 $host）
# $host 会被规范化丢失端口 → server origin 校验 403 → WS 连不上
#
# ⚠️ 安全：token 会出现在 WS 握手 URL（/ws?token=...），nginx 默认 access log 记录完整
# query（$request）→ token 持久化到日志。必须用下方自定义 log_format（只记 $uri 不记 query、
# 不含 $http_referer——首次加载窗口内 Referer 仍带旧 URL）；建议同时配置 HTTPS。

# log_format 只能定义在 http 上下文（server 块内 nginx -t 会报错）
log_format promalogs '$remote_addr - $remote_user [$time_local] "$request_method $uri $server_protocol" $status $body_bytes_sent "$http_user_agent"';

server {
    listen 0.0.0.0:6811;   # 对外端口，可改

    # 日志脱敏：$request 换成 $uri（不含 query），且不含 $http_referer（首访 Referer 含 token）
    access_log /var/log/nginx/proma-web-access.log promalogs;
    # ⚠️ error_log 是 nginx 内建格式（不受 log_format 控制）：后端不可达/握手超时等错误会记录完整
    # 请求行（含 /ws?token=...）→ 独立 error_log 便于单独保护；建议手动收紧权限：
    #   sudo install -m 640 -o root -g adm /dev/null /var/log/nginx/proma-web-error.log
    #   sudo touch /var/log/nginx/proma-web-access.log && sudo chmod 640 /var/log/nginx/proma-web-access.log
    error_log /var/log/nginx/proma-web-error.log warn;

    location / {
        proxy_pass http://127.0.0.1:6810;   # 后端 Bun server（与 server 默认端口一致）
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $http_host;   # ★ 关键：保留原始 Host（含端口）
        # 可信反代时透传真实客户端 IP（server 端需 PROMA_WEB_TRUST_PROXY=1）：
        # 显式覆盖 XFF 只取直连地址，防客户端伪造（不设此行则 $proxy_add_x_forwarded_for 会拼接客户端伪值到首位）；
        # 不可信反代/无 TRUST_PROXY 场景可删除此行
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_read_timeout 3600s;
        proxy_buffering off;
    }
}
